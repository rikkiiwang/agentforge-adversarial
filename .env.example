# Copy to .env and fill in OPENAI_API_KEY.
OPENAI_API_KEY=sk-...

# Local Postgres (docker compose up -d).
# When populating Railway: temporarily override with the Railway-managed URL,
#   e.g. postgresql://...@containers-us-west-N.railway.app:.../railway?sslmode=require
DATABASE_URL=postgresql://agentforge:agentforge_dev@localhost:5433/agentforge

# Deployed Co-Pilot — used by CopilotClient when --live is passed.
TARGET_URL=https://copilot-production-b532.up.railway.app
TARGET_VERSION=manual-mvp

# Live target session, obtained from the Co-Pilot iframe's POST /v1/sessions
# response in browser devtools. Short-lived; refresh per demo session.
#   COPILOT_SESSION_ID=f2a19959-89dc-4b92-91a5-9ee9f2ea4840
