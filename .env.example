# Copy to .env and fill in OPENAI_API_KEY. The dashboard + CLI both call
# `python-dotenv.load_dotenv()` so values here flow into both surfaces.

# Required for the LLM Judge (gpt-4o-mini), the Red Team mutator + class-probe,
# and the partial-reentry subagent. Without this, the harness falls back to
# keyword-only Judge and skips all LLM swarm steps.
OPENAI_API_KEY=sk-...

# Local Postgres (docker compose up -d).
# When populating Railway: override at deploy time with the Railway-managed URL,
#   e.g. postgresql://...@containers-us-west-N.railway.app:.../railway?sslmode=require
DATABASE_URL=postgresql://agentforge:agentforge_dev@localhost:5433/agentforge

# Default deployed Co-Pilot URL. Only used by tests / standalone tooling; the
# CLI runner now resolves the target via the `targets` table, so this is
# informational rather than load-bearing.
TARGET_URL=https://copilot-production-b532.up.railway.app
TARGET_VERSION=manual-mvp

# Live Co-Pilot target — env-var fallback for `make_client()`.
#
# The seeded `OpenEMR Clinical Co-Pilot (deployed)` row in `targets` stores
# `patient_id=""` by design (every operator's Synthea UUID is different).
# When `config_json.patient_id` is empty, `target.py:make_client()` falls
# back to these env vars. So `export COPILOT_PATIENT_ID=...; make run-live`
# is the frictionless live-target path.
#
# Alternative: write the UUID into the row durably with the CLI —
#   python -m agentforge_adversarial update-target \
#     --name "OpenEMR Clinical Co-Pilot (deployed)" \
#     --patient-id <uuid>
#
# Grab a UUID from the OpenEMR patient list URL (the `pid` query param).
# Sessions are recreated automatically on 404, so the value is durable for
# the campaign's lifetime.
#   COPILOT_PATIENT_ID=0fe1a5d2-1234-5678-9abc-def012345678
COPILOT_PATIENT_ID=
COPILOT_PHYSICIAN_USER_ID=admin
